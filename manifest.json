{
  "manifest_version": 3,
  "name": "OutOfOffice Guard",
  "version": "1.2.1",
  "description": "Locally checks out-of-office replies and offers opt-in live protection.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "OutOfOffice Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
